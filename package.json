{
  "name": "nx-resume-client",
  "version": "22.0.5",
  "author": "Scott Robertson (https://github.com/sc0tt5)",
  "license": "SEE LICENSE",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "concurrently --names 'database,angular' --prefix-colors 'blue,yellow,magenta' --kill-others \"npm:serve:database\" \"nx run resume-client:serve --configuration=development\"",
    "start:prod": "concurrently --names 'database,angular' --prefix-colors 'blue,yellow' --kill-others \"npm:serve:database\" \"npm run build:prod && npm run serve:prod\"",
    "build:prod": "nx build resume-client --configuration=production --skip-nx-cache",
    "serve:prod": "node dist/apps/resume-client/server/server.mjs",
    "serve:database": "npm run prebuild && json-server --watch db.json --port 8800 --middlewares ./node_modules/json-server-reset",
    "prebuild": "ts-node tools/scripts/prebuild.ts",
    "test": "nx run-many --target=test --all --coverage --watch=false",
    "lint": "npm run lint:styles && nx run-many --target=lint --all --maxWarnings=0",
    "lint:styles": "stylelint \"{apps,libs}/**/*.scss\" --max-warnings=0",
    "dep-graph": "nx dep-graph",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "lighthouse": "lhci autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-server": "22.1.6",
    "@angular/router": "22.1.6",
    "@angular/ssr": "22.1.8",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2201.8",
    "@angular-devkit/core": "22.1.8",
    "@angular-devkit/schematics": "22.1.8",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/language-service": "22.1.6",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.1.8",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@types/express": "5.0.6",
    "@types/json-server": "0.14.8",
    "@types/node": "22.20.2",
    "@typescript-eslint/utils": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "json-server": "0.17.4",
    "json-server-reset": "1.6.4",
    "lint-staged": "17.5.1",
    "nx": "23.2.1",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
